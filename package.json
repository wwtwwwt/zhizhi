{
  "name": "zhizhi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:electron": "npm run build && node scripts/build-electron.mjs && node scripts/build-icons.mjs",
    "dev:electron": "node scripts/build-electron.mjs && node scripts/dev-electron.mjs",
    "start:electron": "electron .",
    "pack": "npm run build:electron && electron-builder --dir --publish never",
    "dist": "npm run build:electron && electron-builder --publish never",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "htmlparser2": "^12.0.0",
    "katex": "^0.18.10",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "undici": "^8.12.3",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/express": "^5.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "katex": "$katex"
  },
  "description": "枝知：支持持久分支、笔记与内容重构的本地 AI 对话工具",
  "author": "zhizhi",
  "main": "dist-electron/main.js",
  "license": "AGPL-3.0-only"
}
